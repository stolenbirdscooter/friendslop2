; Engine configuration file.
; Mossback — a co-op game about walking a very large friend.

config_version=5

[application]

config/name="Mossback v0.4 — Gales config/name="Mossback" Magpies"
config/description="Tiny caretakers, one enormous wandering beast."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

G="*res://src/core/g.gd"
Sfx="*res://src/audio/sfx.gd"
Music="*res://src/audio/music.gd"
Net="*res://src/net/net.gd"
Voice="*res://src/net/voice.gd"

[audio]

driver/enable_input=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="disabled"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=false

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.95, 0.91, 0.82, 1)
textures/canvas_textures/default_texture_filter=1
